# GEMINI_API_KEY: Required for Gemini AI API calls in future AI assistant phases.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign authentication tokens on the backend.
# In development, a fallback ephemeral secret is generated if omitted.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# VITE_API_BASE_URL: Optional override if pointing the React frontend directly
# to the standalone Java Spring Boot backend (e.g., http://localhost:8080).
# Leave empty to use same-origin /api/v1 routes.
VITE_API_BASE_URL=""

# PLANT_DISEASE_INFERENCE_URL: Optional URL of the Python FastAPI crop disease inference
# service (e.g., http://localhost:8001). Leave empty when running without a live model;
# KrishiSetu will display an honest unavailable state and never fabricate predictions.
PLANT_DISEASE_INFERENCE_URL=""
PLANT_DISEASE_INFERENCE_API_KEY=""

