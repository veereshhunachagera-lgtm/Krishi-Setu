# GEMINI_API_KEY: Required for Gemini AI API calls in the AI Farmer Assistant.
# Set server-side only (never expose in client code).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign authentication tokens on the backend.
# In development, a fallback ephemeral secret is generated if omitted.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# VITE_API_BASE_URL: Optional override if pointing the React frontend directly
# to the standalone Java Spring Boot backend (e.g., http://localhost:8080).
# Leave empty to use same-origin /api/v1 routes.
VITE_API_BASE_URL=""

# PLANT_DISEASE_INFERENCE_URL: Optional URL of the Python FastAPI crop disease inference
# service (e.g., http://localhost:8001). Leave empty when running without a live model;
# KrishiSetu will display an honest unavailable state and never fabricate predictions.
PLANT_DISEASE_INFERENCE_URL=""
PLANT_DISEASE_INFERENCE_API_KEY=""

# DATA_GOV_IN_API_KEY: Server-side API key from https://data.gov.in/ for Agmarknet
# daily/historical mandi price datasets. Leave empty if unconfigured; KrishiSetu will
# display an honest unavailable state and required configuration steps without fake data.
DATA_GOV_IN_API_KEY=""
DATA_GOV_IN_MANDI_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"
DATA_GOV_IN_HISTORY_RESOURCE_ID="35985678-0d79-46b4-9ed6-6f13308a1d24"

# Open-Meteo Forecast and Geocoding endpoints (free non-commercial tier, CC BY 4.0 attribution)
OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1/search"
